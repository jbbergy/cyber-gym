# Copié en .env sur le serveur par scripts/server-setup.sh (mot de passe généré là-bas)
DATABASE_URL=postgres://cybergym:CHANGE_ME@postgres:5432/cybergym
# Compte qui récupère les données existantes (créées avant les comptes utilisateurs)
OWNER_EMAIL=jibhey@proton.me
# Lien « mot de passe oublié »
APP_URL=https://gym.jibhey.fr
# Envoi d'e-mails via Brevo (sinon le lien est seulement écrit dans les logs)
SMTP_HOST=smtp-relay.brevo.com
