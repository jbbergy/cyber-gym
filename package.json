{
  "name": "cyber-gym",
  "private": true,
  "description": "Suivi musculation — PWA Vue 3 + Node + PGlite/PostgreSQL",
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client",
    "start": "NODE_ENV=production npm run start -w server",
    "db:demo": "npm run demo -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
